# MongoDB Atlas Connection URI (Required for Vercel production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mypet?retryWrites=true&w=majority

# JWT Secret Key for Doctor Authentication (Required)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Frontend API Base Path (Defaults to /api for single Vercel domain deployment)
VITE_API_URL=/api
